# ─── Supabase ─────────────────────────────────────────────
# Obtené estos valores desde: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── Resend ───────────────────────────────────────────────
# Obtené tu API key desde: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# ─── Mercado Pago (OAuth — para MP Connect flow) ─────────
# Obtené CLIENT_ID y CLIENT_SECRET desde:
# https://www.mercadopago.com.ar/developers/panel → tu app → Credenciales
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
NEXT_PUBLIC_MP_CONNECT_REDIRECT_URI=http://localhost:3000/api/mercadopago/callback

# Clave para encriptar tokens MP en la DB (generar con: openssl rand -hex 32)
MP_TOKEN_ENCRYPTION_KEY=

# ─── Cron ─────────────────────────────────────────────────
# Secret compartido entre Vercel Cron y la app para proteger el endpoint
CRON_SECRET=your_cron_secret
